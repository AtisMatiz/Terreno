# Copy to .env for local runs. Never commit .env.
# In GitHub Actions these live in Settings -> Secrets and variables -> Actions.

# --- Layer B: long-tail discovery (free tier: 2000 queries/month)
BRAVE_API_KEY=

# --- Layer C: Facebook via Apify (free plan: $5 credit/month)
APIFY_TOKEN=
# Local Playwright fallback — burner account cookies exported as JSON.
FB_COOKIES_FILE=./fb_cookies.json

# --- Mercado Livre (their API refuses anonymous callers -- a 403 here is an
#     AUTH failure, not an IP block: a residential connection gets the same one)
# Free app at https://developers.mercadolivre.com.br -> Devcenter -> Criar
# aplicação. Enable the "Client Credentials" OAuth flow; nothing else is
# needed, since we only read public search results.
# The app screen calls these "App ID" (client id) and "Secret Key".
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Escape hatch only. Mercado Livre access tokens expire in ~6 hours, so a
# pasted one silently takes the source down the same day -- prefer the pair
# above, which is minted per run and never needs touching.
ML_ACCESS_TOKEN=

# --- Optional: LLM extraction and fit scoring. Off unless ENABLE_LLM=1.
ANTHROPIC_API_KEY=
ENABLE_LLM=0

# --- Optional: Telegram ping when new matches appear
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Link included in the Telegram message
TERRENO_PAGE_URL=
